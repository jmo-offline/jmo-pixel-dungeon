+class_name ClassArmorCharger
+extends Buff
+## Upstream ClassArmor.Charger: refills the worn class armor by 0.2% a turn
+## (500 turns from empty to full). Upstream attaches the charger to the armor
+## while it is worn; here it is a permanent hidden buff on the hero, added
+## when the King's Crown is used, that charges whichever class armor is worn.
+
+func _init() -> void:
+	buff_id = "ClassArmorCharger"
+	buff_name = "Class Armor Charger"
+	buff_type = BuffType.POSITIVE
+	duration = -1
+	revive_persists = true
+	show_in_ui = false
+
+
+func on_turn() -> void:
+	if target == null or not target.is_alive or not _regen_on():
+		return
+	var owner_belongings: Variant = target.get("belongings")
+	if owner_belongings == null:
+		return
+	var worn: Variant = owner_belongings.get("armor")
+	if worn is ClassArmor:
+		(worn as ClassArmor).add_charge(ClassArmor.CHARGE_PER_TURN)
+
+
+func description() -> String:
+	return "Your class armor slowly recharges its ability while you wear it."
+
+
+## Upstream Regeneration.regenOn(): charging pauses on locked boss floors,
+## like natural regeneration and WeaponCharger.
+func _regen_on() -> bool:
+	if GameManager == null:
+		return true
+	var depth: int = GameManager.depth
+	if depth % 5 == 0 and depth > 0:
+		var level: Variant = GameManager.current_level
+		if level != null and level.has_method("is_locked") and level.is_locked():
+			return false
+	return true
