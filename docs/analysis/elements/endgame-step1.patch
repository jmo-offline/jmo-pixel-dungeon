+class_name WndChooseAbility
+extends WndBase
+## Upstream WndChooseAbility: lists the hero class's three armor abilities.
+## Choosing one consumes the King's Crown, turns the worn armor into class
+## armor and sets the ability. Abilities that aren't ported yet are shown
+## but can't be picked. Cancel closes without cost and keeps the crown.
+
+var _hero: Hero = null
+var _crown: KingsCrown = null
+
+
+func _init() -> void:
+	window_title = "Choose an Armor Ability"
+	custom_minimum_size = Vector2(340, 220)
+
+
+func setup(hero: Hero, crown: KingsCrown) -> void:
+	_hero = hero
+	_crown = crown
+	refresh_content()
+
+
+func _build_content() -> Control:
+	var main: VBoxContainer = VBoxContainer.new()
+	main.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	main.add_theme_constant_override("separation", 6)
+	if _hero == null:
+		return main
+
+	var intro: Label = Label.new()
+	intro.text = "The crown will turn your armor into class armor with one of these abilities. This choice is permanent."
+	intro.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+	intro.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	intro.add_theme_font_size_override("font_size", 12)
+	intro.add_theme_color_override("font_color", Color(0.7, 0.65, 0.55))
+	main.add_child(intro)
+
+	for ability: ArmorAbility in ArmorAbility.abilities_for(_hero.hero_class):
+		var button: Button = Button.new()
+		button.text = ability.ability_name
+		if not ability.implemented:
+			button.text += " (coming soon)"
+			button.disabled = true
+		button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		button.pressed.connect(choose.bind(ability.ability_id))
+		main.add_child(button)
+
+		var desc: Label = Label.new()
+		desc.text = ability.get_description()
+		desc.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
+		desc.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+		desc.add_theme_font_size_override("font_size", 11)
+		desc.add_theme_color_override("font_color", Color(0.7, 0.65, 0.55))
+		main.add_child(desc)
+
+	var cancel: Button = Button.new()
+	cancel.text = "Not yet"
+	cancel.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+	cancel.pressed.connect(close_window)
+	main.add_child(cancel)
+
+	return main
+
+
+## Upstream WndChooseAbility -> KingsCrown.upgradeArmor. Unported abilities
+## and a hero who already has an ability are refused. The turn cost is
+## charged by Hero.execute_action's use_item branch.
+func choose(ability_id: String) -> void:
+	if _hero == null or _crown == null:
+		close_window()
+		return
+	var ability: ArmorAbility = ArmorAbility.create(ability_id)
+	if ability == null or not ability.implemented \
+			or ability.hero_class != _hero.hero_class:
+		return
+	_crown.upgrade_armor(_hero, ability)
+	close_window()
