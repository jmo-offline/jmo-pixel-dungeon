+class_name EndureTracker
+extends Buff
+## Upstream Endure.EndureTracker. While the Warrior is enduring (the 3 turns
+## the ability takes), damage he takes is halved and half of it is banked.
+## When he next acts, enduring ends and the bank is added to his next hit.
+## Char.attack applies both sides; Hero.take_damage covers damage that does
+## not come from a character.
+
+var enduring: bool = true
+var damage_bonus: int = 0
+var hits_left: int = 0
+
+
+func _init() -> void:
+	buff_id = "EndureTracker"
+	buff_name = "Endure"
+	buff_type = BuffType.POSITIVE
+	duration = AbilityEndure.TRACKER_DURATION
+	time_left = AbilityEndure.TRACKER_DURATION
+	icon_color = Color(1.0, 0.3, 0.3)
+
+
+## Upstream EndureTracker.adjustDamageTaken.
+func adjust_damage_taken(damage: float) -> float:
+	if enduring:
+		damage_bonus += int(damage / 2.0)
+		return damage * 0.5
+	return damage
+
+
+## Upstream EndureTracker.endEnduring, called when the hero is next ready.
+func end_enduring() -> void:
+	if not enduring:
+		return
+	enduring = false
+	hits_left = 1
+	@warning_ignore("integer_division")
+	damage_bonus = damage_bonus / hits_left
+	if damage_bonus > 0:
+		if MessageLog:
+			MessageLog.add_positive("You are ready to strike back!")
+	elif target != null and target.has_method("remove_buff"):
+		target.remove_buff(self)
+
+
+## Upstream EndureTracker.damageFactor: the banked bonus rides on the next hit.
+func damage_factor(damage: float) -> float:
+	if enduring:
+		return damage
+	var bonus: int = damage_bonus
+	hits_left -= 1
+	if hits_left <= 0 and target != null and target.has_method("remove_buff"):
+		target.remove_buff(self)
+	return damage + float(bonus)
+
+
+func description() -> String:
+	if enduring:
+		return "You are bracing yourself, taking half damage and storing some of it to strike back with."
+	return "Your next attack deals %d bonus damage.\n\nTurns remaining: %s." % [damage_bonus, disp_turns(time_left)]
+
+
+func serialize() -> Dictionary:
+	var data: Dictionary = super.serialize()
+	data["enduring"] = enduring
+	data["damage_bonus"] = damage_bonus
+	data["hits_left"] = hits_left
+	return data
+
+
+func deserialize(data: Dictionary) -> void:
+	super.deserialize(data)
+	enduring = bool(data.get("enduring", enduring))
+	damage_bonus = int(data.get("damage_bonus", damage_bonus))
+	hits_left = int(data.get("hits_left", hits_left))
