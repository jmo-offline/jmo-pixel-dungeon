+class_name AbilityEndure
+extends ArmorAbility
+## Upstream Endure (Warrior armor ability): the Warrior braces for 3 turns,
+## taking half damage and banking half of it, then adds the bank to his next
+## hit. The work happens in EndureTracker.
+##
+## Port adaptations: upstream also adds 3 turns to the Gladiator's combo
+## timer; the port's Combo has no timer, so that part is skipped. The tier-4
+## talents (Sustained Retribution, Shrug It Off, Even the Odds) arrive with
+## the tier-4 talent work.
+
+const ENDURE_TIME: float = 3.0
+const TRACKER_DURATION: float = 12.0
+
+
+func _init() -> void:
+	ability_id = "endure"
+	ability_name = "Endure"
+	hero_class = ConstantsData.HeroClass.WARRIOR
+	short_desc = "The Warrior braces himself for 3 turns, taking half damage. Half of the damage he takes is added to his next attack."
+	base_charge_use = 50.0
+	targeted = false
+	implemented = true
+
+
+func activate(armor: ClassArmor, hero: Hero, _target_pos: int) -> float:
+	if armor == null or hero == null:
+		return -1.0
+	var existing: Node = hero.get_buff("EndureTracker")
+	if existing != null:
+		hero.remove_buff(existing)
+	var tracker: EndureTracker = EndureTracker.new()
+	tracker.set_duration(TRACKER_DURATION)
+	hero.add_buff(tracker)
+
+	armor.charge -= charge_use(hero)
+	Invisibility.dispel_for(hero)
+	if MessageLog:
+		MessageLog.add_positive("You brace yourself to endure.")
+	return ENDURE_TIME
