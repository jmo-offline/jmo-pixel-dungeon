+class_name ClassArmor
+extends Armor
+## Upstream ClassArmor: the armor the King's Crown makes. It keeps the source
+## armor's tier, level, glyph, augment, seal and curse state, and holds a
+## charge (0-100%) that powers the hero's armor ability. ClassArmorCharger
+## refills the charge over time while the armor is worn.
+##
+## Not ported yet: upstream's TRANSFER action (moving the class armor's
+## powers onto a different armor).
+
+const MAX_CHARGE: float = 100.0
+## Upstream ClassArmor.upgrade starts the new armor at half charge.
+const STARTING_CHARGE: float = 50.0
+## Upstream ClassArmor.Charger: 500 turns from empty to full.
+const CHARGE_PER_TURN: float = 100.0 / 500.0
+
+const IDS_BY_CLASS: Dictionary = {
+	ConstantsData.HeroClass.WARRIOR: "warrior_armor",
+	ConstantsData.HeroClass.MAGE: "mage_armor",
+	ConstantsData.HeroClass.ROGUE: "rogue_armor",
+	ConstantsData.HeroClass.HUNTRESS: "huntress_armor",
+	ConstantsData.HeroClass.DUELIST: "duelist_armor",
+}
+
+var charge: float = 0.0
+
+
+func _init() -> void:
+	super._init()
+	default_action = "ABILITY"
+	level_known = true
+	cursed_known = true
+	unique = true
+
+
+static func all_ids() -> Array[String]:
+	return ["warrior_armor", "mage_armor", "rogue_armor", "huntress_armor", "duelist_armor"]
+
+
+## Build an empty class armor by id. Saves and Generator use this; play uses
+## from_armor so the stats come from the armor the crown was used on.
+static func create(armor_id: String) -> ClassArmor:
+	var a: ClassArmor = ClassArmor.new()
+	a.item_id = armor_id
+	match armor_id:
+		"warrior_armor":
+			a.item_name = "Warrior Armor"
+			a.description = "Crafted from the King's Crown, this armor is worthy of a warrior."
+		"mage_armor":
+			a.item_name = "Mage Robe"
+			a.description = "Crafted from the King's Crown, this robe hums with the mage's magic."
+		"rogue_armor":
+			a.item_name = "Rogue Garb"
+			a.description = "Crafted from the King's Crown, this dark garb suits a rogue."
+		"huntress_armor":
+			a.item_name = "Huntress Cloak"
+			a.description = "Crafted from the King's Crown, this cloak is light and silent."
+		"duelist_armor":
+			a.item_name = "Duelist Armor"
+			a.description = "Crafted from the King's Crown, this armor is made for a duelist's footwork."
+		_:
+			a.item_name = armor_id.capitalize()
+	a._update_str_requirement()
+	return a
+
+
+## Upstream ClassArmor.upgrade: turn a regular armor into this hero class's
+## class armor, keeping its tier, level, glyph, augment, seal and curse state.
+static func from_armor(for_class: int, armor: Armor) -> ClassArmor:
+	var armor_id: String = str(IDS_BY_CLASS.get(for_class, "warrior_armor"))
+	var a: ClassArmor = null
+	if Generator:
+		a = Generator.create_item(armor_id) as ClassArmor
+	if a == null:
+		a = create(armor_id)
+	if armor != null:
+		a.level = armor.level
+		a.tier = armor.tier
+		a.augment = armor.augment
+		a.glyph = armor.glyph
+		a.seal_attached = armor.seal_attached
+		a.enchant_hardened = armor.enchant_hardened
+		a.cursed = armor.cursed
+		a.curse_infusion_bonus = armor.curse_infusion_bonus
+		a.mastery_potion_bonus = armor.mastery_potion_bonus
+		if armor.level_known and armor.cursed_known:
+			a.identify()
+		else:
+			a.level_known = armor.level_known
+			a.cursed_known = true
+	a.charge = STARTING_CHARGE
+	a._update_str_requirement()
+	return a
+
+
+func add_charge(amount: float) -> void:
+	charge = clampf(charge + amount, 0.0, MAX_CHARGE)
+
+
+## Upstream ClassArmor.value: class armor can't be sold.
+func value() -> int:
+	return 0
+
+
+func get_stats_text() -> String:
+	return "%s  Charge: %d%%" % [super.get_stats_text(), int(floor(charge))]
+
+
+func duplicate_item() -> Item:
+	var copy: ClassArmor = ClassArmor.create(item_id)
+	_copy_base_properties(copy)
+	copy.tier = tier
+	copy.augment = augment
+	copy.charge = charge
+	if glyph != null:
+		copy.glyph = ArmorGlyph.create(glyph.glyph_id)
+	copy._update_str_requirement()
+	return copy
+
+
+func serialize() -> Dictionary:
+	var data: Dictionary = super.serialize()
+	data["charge"] = charge
+	return data
+
+
+func deserialize(data: Dictionary) -> void:
+	super.deserialize(data)
+	charge = clampf(float(data.get("charge", 0.0)), 0.0, MAX_CHARGE)
