diff --git a/src/actors/hero/abilities/armor_ability.gd b/src/actors/hero/abilities/armor_ability.gd
new file mode 100644
index 0000000..be39a2a
--- /dev/null
+++ b/src/actors/hero/abilities/armor_ability.gd
@@ -0,0 +1,127 @@
+class_name ArmorAbility
+extends RefCounted
+## Upstream ArmorAbility: the active power a hero picks when the King's Crown
+## turns their armor into class armor. Each class has three. Using one spends
+## a share of the class armor's charge.
+##
+## Abilities that are not ported yet are registered with implemented = false,
+## so the choice window can list them without letting them be picked (the same
+## pattern TalentData uses for unimplemented talents).
+
+var ability_id: String = ""
+var ability_name: String = ""
+var short_desc: String = ""
+var hero_class: int = ConstantsData.HeroClass.WARRIOR
+## Upstream ArmorAbility.baseChargeUse.
+var base_charge_use: float = 35.0
+## True when the ability asks for a target cell before activating.
+var targeted: bool = false
+var implemented: bool = false
+
+
+## Upstream ArmorAbility.chargeUse. Heroic Energy is a tier-4 talent and is
+## not ported yet, so the cost is the base cost.
+func charge_use(_hero: Hero) -> float:
+	return base_charge_use
+
+
+## Upstream ArmorAbility.activate. Returns the time the hero spends, or a
+## negative number when the ability was refused and nothing was spent.
+func activate(_armor: ClassArmor, _hero: Hero, _target_pos: int) -> float:
+	return -1.0
+
+
+## Upstream ArmorAbility.desc: short description plus the charge cost.
+func get_description() -> String:
+	if not implemented:
+		return short_desc
+	return "%s\n\nUses %d%% of the armor's charge." % [short_desc, int(base_charge_use)]
+
+
+# ---------------------------------------------------------------------------
+# Registry
+# ---------------------------------------------------------------------------
+
+## The three abilities a class can choose from, in upstream order.
+static func abilities_for(for_class: int) -> Array[ArmorAbility]:
+	var result: Array[ArmorAbility] = []
+	for id: String in ids_for(for_class):
+		var ability: ArmorAbility = create(id)
+		if ability != null:
+			result.append(ability)
+	return result
+
+
+static func ids_for(for_class: int) -> Array[String]:
+	match for_class:
+		ConstantsData.HeroClass.WARRIOR:
+			return ["heroic_leap", "shockwave", "endure"]
+		ConstantsData.HeroClass.MAGE:
+			return ["elemental_blast", "wild_magic", "warp_beacon"]
+		ConstantsData.HeroClass.ROGUE:
+			return ["smoke_bomb", "death_mark", "shadow_clone"]
+		ConstantsData.HeroClass.HUNTRESS:
+			return ["spectral_blades", "natures_power", "spirit_hawk"]
+		ConstantsData.HeroClass.DUELIST:
+			return ["challenge", "elemental_strike", "feint"]
+	return []
+
+
+## Build an ability by id, or null for an unknown id.
+static func create(id: String) -> ArmorAbility:
+	match id:
+		"endure":
+			return AbilityEndure.new()
+		"heroic_leap":
+			return _inert(id, "Heroic Leap", ConstantsData.HeroClass.WARRIOR,
+				"The Warrior leaps to a chosen spot, slamming down on nearby enemies.")
+		"shockwave":
+			return _inert(id, "Shockwave", ConstantsData.HeroClass.WARRIOR,
+				"The Warrior slams the ground, sending out a cone of force that damages and cripples enemies.")
+		"elemental_blast":
+			return _inert(id, "Elemental Blast", ConstantsData.HeroClass.MAGE,
+				"The Mage releases a blast of magic around himself, shaped by the wand in his staff.")
+		"wild_magic":
+			return _inert(id, "Wild Magic", ConstantsData.HeroClass.MAGE,
+				"The Mage zaps a target several times with random wands from his pack.")
+		"warp_beacon":
+			return _inert(id, "Warp Beacon", ConstantsData.HeroClass.MAGE,
+				"The Mage places a beacon that he can teleport back to later.")
+		"smoke_bomb":
+			return _inert(id, "Smoke Bomb", ConstantsData.HeroClass.ROGUE,
+				"The Rogue vanishes in smoke and reappears a short distance away, blinding nearby enemies.")
+		"death_mark":
+			return _inert(id, "Death Mark", ConstantsData.HeroClass.ROGUE,
+				"The Rogue marks an enemy, making it take more damage and stopping it from dying until the mark ends.")
+		"shadow_clone":
+			return _inert(id, "Shadow Clone", ConstantsData.HeroClass.ROGUE,
+				"The Rogue summons a shadow clone that fights beside him.")
+		"spectral_blades":
+			return _inert(id, "Spectral Blades", ConstantsData.HeroClass.HUNTRESS,
+				"The Huntress throws a volley of spectral blades at a target.")
+		"natures_power":
+			return _inert(id, "Nature's Power", ConstantsData.HeroClass.HUNTRESS,
+				"The Huntress draws on nature to attack faster with her bow for a time.")
+		"spirit_hawk":
+			return _inert(id, "Spirit Hawk", ConstantsData.HeroClass.HUNTRESS,
+				"The Huntress summons a spirit hawk that scouts and fights for her.")
+		"challenge":
+			return _inert(id, "Challenge", ConstantsData.HeroClass.DUELIST,
+				"The Duelist challenges an enemy to a duel in a sealed arena.")
+		"elemental_strike":
+			return _inert(id, "Elemental Strike", ConstantsData.HeroClass.DUELIST,
+				"The Duelist strikes in a cone, with an extra effect based on her weapon's enchantment.")
+		"feint":
+			return _inert(id, "Feint", ConstantsData.HeroClass.DUELIST,
+				"The Duelist dodges aside, leaving a decoy that enemies attack instead.")
+	return null
+
+
+static func _inert(id: String, display_name: String, for_class: int, desc: String) -> ArmorAbility:
+	var ability: ArmorAbility = ArmorAbility.new()
+	ability.ability_id = id
+	ability.ability_name = display_name
+	ability.hero_class = for_class
+	ability.short_desc = desc
+	ability.implemented = false
+	return ability
