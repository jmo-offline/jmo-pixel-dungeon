@@ -0,0 +1,75 @@
+class_name KingsCrown
+extends Item
+## Upstream KingsCrown, dropped by the King of Dwarves. Wearing it opens
+## WndChooseAbility; choosing an ability turns the worn armor into class
+## armor and sets the hero's armor ability for the rest of the run.
+
+
+func _init() -> void:
+	item_id = "kings_crown"
+	item_name = "King's Crown"
+	description = "This crown once belonged to the King of Dwarves. It could be used to reforge your armor into something worthy of a true hero, unlocking a powerful ability."
+	category = ConstantsData.ItemCategory.MISC
+	default_action = "WEAR"
+	stackable = false
+	unique = true
+	identified = true
+	level_known = true
+	cursed_known = true
+
+
+func is_upgradeable() -> bool:
+	return false
+
+
+func is_identified() -> bool:
+	return true
+
+
+## Upstream KingsCrown.execute(AC_WEAR): needs worn armor, then opens the
+## ability choice. Nothing is spent until an ability is chosen.
+func execute(hero: Char) -> void:
+	if hero == null or not (hero is Hero):
+		return
+	var h: Hero = hero as Hero
+	if h.armor_ability != null:
+		if MessageLog:
+			MessageLog.add_warning("You have already chosen your armor ability.")
+		return
+	if h.belongings == null or not (h.belongings.armor is Armor):
+		if MessageLog:
+			MessageLog.add_warning("You need to be wearing armor to use the crown.")
+		return
+	var wnd: WndChooseAbility = WndChooseAbility.new()
+	wnd.setup(h, self)
+	if EventBus:
+		EventBus.show_window.emit(wnd)
+
+
+## Upstream KingsCrown.upgradeArmor: consume the crown, swap the worn armor
+## for class armor and set the hero's ability. Returns false when refused.
+func upgrade_armor(hero: Hero, ability: ArmorAbility) -> bool:
+	if hero == null or ability == null or not ability.implemented:
+		return false
+	if hero.armor_ability != null or hero.belongings == null:
+		return false
+	var worn: Variant = hero.belongings.armor
+	if not (worn is Armor):
+		return false
+	hero.belongings.remove_item(self)
+
+	var class_armor: ClassArmor = ClassArmor.from_armor(hero.hero_class, worn as Armor)
+	# Assigned directly, as upstream does, so equip side effects (curse
+	# messages, intuition rolls) don't fire a second time.
+	hero.belongings.armor = class_armor
+	hero.armor_ability = ability
+	if not hero.has_buff("ClassArmorCharger"):
+		hero.add_buff(ClassArmorCharger.new())
+
+	if MessageLog:
+		MessageLog.add_positive("The crown dissolves into your armor, which glows with new power!")
+	if AudioManager:
+		AudioManager.play_sfx("mastery")
+	if EventBus:
+		EventBus.hero_stats_changed.emit()
+	return true
