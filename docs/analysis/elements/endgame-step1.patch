+extends RefCounted
+## King's Crown, class armor and the Warrior's Endure ability (upstream
+## KingsCrown, ClassArmor, ArmorAbility, Endure). Covers:
+##   - the crown needs worn armor and opens WndChooseAbility
+##   - unported abilities are refused; choosing Endure converts the worn
+##     armor into class armor that keeps its stats, at 50% charge
+##   - the charger refills 0.2% per turn up to 100%
+##   - Endure spends 50% charge and 3 turns, halves and banks damage while
+##     bracing, then adds the bank to the next hit
+##   - hero save round trip keeps the ability, class armor and charge
+##   - the King of Dwarves drops the crown
+
+var _shown_window: WndBase = null
+
+
+class StubLevel:
+	extends RefCounted
+	var drops: Array = []
+	func drop_item(pos: int, item: Variant, _heap_type: String = "heap") -> Dictionary:
+		drops.append({"pos": pos, "item": item})
+		return {}
+
+
+func run(t: Object) -> void:
+	EventBus.show_window.connect(_on_show_window)
+
+	_test_registry(t)
+	_test_generator_ids(t)
+	_test_crown_needs_armor(t)
+	_test_unported_ability_refused(t)
+	_test_choose_endure_converts_armor(t)
+	_test_other_class_gets_own_armor(t)
+	_test_charger_refills(t)
+	_test_endure_activation(t)
+	_test_endure_tracker(t)
+	_test_endure_non_char_damage(t)
+	_test_save_round_trip(t)
+	_test_king_drops_crown(t)
+
+	EventBus.show_window.disconnect(_on_show_window)
+
+
+func _on_show_window(wnd: Variant) -> void:
+	_shown_window = wnd as WndBase
+
+
+func _clear_window() -> void:
+	if _shown_window != null:
+		_shown_window.free()
+		_shown_window = null
+
+
+func _make_hero(hero_class: int = ConstantsData.HeroClass.WARRIOR) -> Hero:
+	var hero := Hero.new()
+	hero.init_class(hero_class)
+	var armor: Armor = Generator.create_item("mail_armor") as Armor
+	armor.level = 2
+	armor.augment = Armor.Augment.DEFENSE
+	armor.inscribe(ArmorGlyph.create("obfuscation"))
+	armor.seal_attached = true
+	armor.identify()
+	hero.belongings.equip_armor(armor)
+	hero.belongings.add_item(Generator.create_item("kings_crown"))
+	return hero
+
+
+func _find_crown(hero: Hero) -> Item:
+	return hero.belongings.find_item_by_id("kings_crown")
+
+
+## Make a warrior who has already used the crown on Endure.
+func _make_endure_hero() -> Hero:
+	var hero := _make_hero()
+	var crown: KingsCrown = _find_crown(hero) as KingsCrown
+	crown.upgrade_armor(hero, ArmorAbility.create("endure"))
+	return hero
+
+
+func _test_registry(t: Object) -> void:
+	var classes: Array[int] = [
+		ConstantsData.HeroClass.WARRIOR, ConstantsData.HeroClass.MAGE,
+		ConstantsData.HeroClass.ROGUE, ConstantsData.HeroClass.HUNTRESS,
+		ConstantsData.HeroClass.DUELIST,
+	]
+	var implemented: Array[String] = []
+	for hero_class: int in classes:
+		var abilities: Array[ArmorAbility] = ArmorAbility.abilities_for(hero_class)
+		t.check(abilities.size() == 3, "class %d offers three armor abilities" % hero_class)
+		for ability: ArmorAbility in abilities:
+			t.check(ability.hero_class == hero_class,
+				"%s belongs to the class that offers it" % ability.ability_id)
+			if ability.implemented:
+				implemented.append(ability.ability_id)
+	t.check(implemented == ["endure"], "only Endure is implemented so far")
+	t.check(ArmorAbility.create("endure").charge_use(null) == 50.0, "Endure costs 50% charge")
+	t.check(ArmorAbility.create("nonsense") == null, "unknown ability ids build nothing")
+
+
+func _test_generator_ids(t: Object) -> void:
+	var crown: Item = Generator.create_item("kings_crown")
+	t.check(crown is KingsCrown, "Generator builds the King's Crown")
+	t.check(crown != null and crown.sprite_index == 60, "the crown uses the SPD crown sprite")
+	var class_armor: Item = Generator.create_item("warrior_armor")
+	t.check(class_armor is ClassArmor, "Generator builds class armor by id")
+	t.check(class_armor != null and class_armor.sprite_index == 181,
+		"warrior armor uses the SPD warrior armor sprite")
+	t.check(not Armor.all_ids().has("warrior_armor"), "class armor is not in the random armor pool")
+
+
+func _test_crown_needs_armor(t: Object) -> void:
+	var hero := _make_hero()
+	var crown: Item = _find_crown(hero)
+	var armor: Item = hero.belongings.unequip("armor")
+	_shown_window = null
+	crown.execute(hero)
+	t.check(_shown_window == null, "the crown does nothing without worn armor")
+	_clear_window()
+
+	hero.belongings.equip_armor(armor)
+	crown.execute(hero)
+	t.check(_shown_window is WndChooseAbility, "wearing the crown opens the ability choice")
+	t.check(_find_crown(hero) != null, "the crown is kept until an ability is chosen")
+	_clear_window()
+	hero.free()
+
+
+func _test_unported_ability_refused(t: Object) -> void:
+	var hero := _make_hero()
+	var crown: Item = _find_crown(hero)
+	_shown_window = null
+	crown.execute(hero)
+	var wnd: WndChooseAbility = _shown_window as WndChooseAbility
+	if wnd != null:
+		wnd.choose("heroic_leap")
+		wnd.choose("elemental_blast")
+	t.check(hero.armor_ability == null, "unported or other-class abilities can't be chosen")
+	t.check(_find_crown(hero) != null, "a refused choice keeps the crown")
+	t.check(not (hero.belongings.armor is ClassArmor), "a refused choice leaves the armor alone")
+	_clear_window()
+	hero.free()
+
+
+func _test_choose_endure_converts_armor(t: Object) -> void:
+	var hero := _make_hero()
+	var crown: Item = _find_crown(hero)
+	_shown_window = null
+	crown.execute(hero)
+	var wnd: WndChooseAbility = _shown_window as WndChooseAbility
+	t.check(wnd != null, "the crown shows a WndChooseAbility")
+	if wnd != null:
+		wnd.choose("endure")
+
+	var worn: ClassArmor = hero.belongings.armor as ClassArmor
+	t.check(hero.armor_ability != null and hero.armor_ability.ability_id == "endure",
+		"choosing Endure sets the hero's armor ability")
+	t.check(_find_crown(hero) == null, "choosing consumes the crown")
+	t.check(worn != null and worn.item_id == "warrior_armor", "the worn armor becomes warrior armor")
+	if worn != null:
+		t.check(worn.tier == 3, "class armor keeps the source tier")
+		t.check(worn.level == 2, "class armor keeps the source level")
+		t.check(worn.augment == Armor.Augment.DEFENSE, "class armor keeps the augment")
+		t.check(worn.glyph != null and worn.glyph.glyph_id == "obfuscation", "class armor keeps the glyph")
+		t.check(worn.seal_attached, "class armor keeps the broken seal")
+		t.check(worn.is_identified(), "identified source armor gives identified class armor")
+		t.check(is_equal_approx(worn.charge, 50.0), "class armor starts at 50% charge")
+		t.check(worn.dr_max() == Armor.create("mail_armor").dr_max(2) + 4,
+			"class armor defends like the source armor")
+		t.check(worn.value() == 0, "class armor can't be sold")
+	t.check(hero.has_buff("ClassArmorCharger"), "the hero gains the class armor charger")
+
+	var crown_again: Item = Generator.create_item("kings_crown")
+	hero.belongings.add_item(crown_again)
+	_clear_window()
+	crown_again.execute(hero)
+	t.check(_shown_window == null, "a second crown is refused once an ability is chosen")
+	_clear_window()
+	hero.free()
+
+
+func _test_other_class_gets_own_armor(t: Object) -> void:
+	var armor: Armor = Armor.create("leather_armor")
+	armor.cursed = true
+	var robe: ClassArmor = ClassArmor.from_armor(ConstantsData.HeroClass.MAGE, armor)
+	t.check(robe.item_id == "mage_armor", "a mage's crown makes a mage robe")
+	t.check(robe.cursed and robe.cursed_known, "curses carry over and become known")
+	t.check(not robe.level_known, "an unidentified level stays unknown")
+
+
+func _test_charger_refills(t: Object) -> void:
+	var hero := _make_endure_hero()
+	var worn: ClassArmor = hero.belongings.armor as ClassArmor
+	var charger: ClassArmorCharger = hero.get_buff("ClassArmorCharger") as ClassArmorCharger
+	worn.charge = 10.0
+	for _i: int in range(5):
+		charger.on_turn()
+	t.check(is_equal_approx(worn.charge, 11.0), "the charger adds 0.2% per turn")
+	worn.charge = 99.9
+	charger.on_turn()
+	t.check(is_equal_approx(worn.charge, 100.0), "charge caps at 100%")
+	hero.free()
+
+
+func _test_endure_activation(t: Object) -> void:
+	var hero := _make_endure_hero()
+	var worn: ClassArmor = hero.belongings.armor as ClassArmor
+	worn.charge = 60.0
+	hero._do_armor_ability(hero.pos)
+	t.check(is_equal_approx(hero._ability_spend, 3.0 * hero.get_speed()),
+		"Endure takes 3 turns (scaled like other non-movement actions)")
+	t.check(is_equal_approx(worn.charge, 10.0), "Endure spends 50% charge")
+	var tracker: EndureTracker = hero.get_buff("EndureTracker") as EndureTracker
+	t.check(tracker != null and tracker.enduring, "Endure starts the bracing tracker")
+
+	hero._ability_spend = 0.0
+	hero._do_armor_ability(hero.pos)
+	t.check(hero._ability_spend == 0.0, "Endure is refused without enough charge")
+	t.check(is_equal_approx(worn.charge, 10.0), "a refused Endure spends no charge")
+
+	var bare := _make_endure_hero()
+	(bare.belongings.armor as ClassArmor).charge = 100.0
+	bare.belongings.unequip("armor")
+	bare._do_armor_ability(bare.pos)
+	t.check(bare._ability_spend == 0.0 and not bare.has_buff("EndureTracker"),
+		"the ability needs the class armor to be worn")
+	bare.free()
+	hero.free()
+
+
+func _test_endure_tracker(t: Object) -> void:
+	var hero := _make_endure_hero()
+	var tracker: EndureTracker = EndureTracker.new()
+	hero.add_buff(tracker)
+	t.check(is_equal_approx(tracker.adjust_damage_taken(10.0), 5.0), "bracing halves damage taken")
+	t.check(tracker.adjust_damage_taken(7.0) == 3.5, "bracing halves odd damage too")
+	t.check(tracker.damage_bonus == 8, "half of each hit is banked (5 + 3)")
+	tracker.end_enduring()
+	t.check(not tracker.enduring and tracker.hits_left == 1, "bracing ends with one empowered hit")
+	t.check(is_equal_approx(tracker.adjust_damage_taken(10.0), 10.0), "no reduction after bracing ends")
+	t.check(is_equal_approx(tracker.damage_factor(4.0), 12.0), "the next hit carries the banked damage")
+	t.check(not hero.has_buff("EndureTracker"), "the tracker ends after the empowered hit")
+
+	var empty: EndureTracker = EndureTracker.new()
+	hero.add_buff(empty)
+	empty.end_enduring()
+	t.check(not hero.has_buff("EndureTracker"), "bracing with nothing banked just ends")
+	hero.free()
+
+
+func _test_endure_non_char_damage(t: Object) -> void:
+	var hero := _make_endure_hero()
+	hero.hp = 50
+	hero.hp_max = 50
+	hero.ht = 50
+	hero.add_buff(EndureTracker.new())
+	var hp_before: int = hero.hp
+	hero.take_damage(10, "poison")
+	t.check(hp_before - hero.hp == 5, "bracing halves damage from non-character sources")
+	hero.free()
+
+
+func _test_save_round_trip(t: Object) -> void:
+	var hero := _make_endure_hero()
+	(hero.belongings.armor as ClassArmor).charge = 73.5
+	var data: Dictionary = hero.serialize()
+
+	var loaded := Hero.new()
+	loaded.deserialize(data)
+	var worn: ClassArmor = loaded.belongings.armor as ClassArmor
+	t.check(loaded.armor_ability != null and loaded.armor_ability.ability_id == "endure",
+		"the armor ability survives a save")
+	t.check(worn != null and worn.item_id == "warrior_armor", "the class armor survives a save")
+	t.check(worn != null and is_equal_approx(worn.charge, 73.5), "the charge survives a save")
+	t.check(worn != null and worn.tier == 3 and worn.level == 2, "class armor stats survive a save")
+	t.check(loaded.has_buff("ClassArmorCharger"), "the charger is present after loading")
+
+	var plain := Hero.new()
+	plain.init_class(ConstantsData.HeroClass.WARRIOR)
+	var plain_loaded := Hero.new()
+	plain_loaded.deserialize(plain.serialize())
+	t.check(plain_loaded.armor_ability == null and not plain_loaded.has_buff("ClassArmorCharger"),
+		"a hero without an ability loads without one")
+	plain.free()
+	plain_loaded.free()
+	loaded.free()
+	hero.free()
+
+
+func _test_king_drops_crown(t: Object) -> void:
+	var king: DwarfKing = DwarfKing.new()
+	var level: StubLevel = StubLevel.new()
+	king.level = level
+	king.pos = ConstantsData.xy_to_pos(16, 10)
+	king._on_death(null)
+	var crowns: int = 0
+	var crown_pos: int = -1
+	for entry: Dictionary in level.drops:
+		var item: Item = entry["item"] as Item
+		if item is KingsCrown:
+			crowns += 1
+			crown_pos = entry["pos"]
+	t.check(crowns == 1, "the King of Dwarves drops exactly one crown")
+	t.check(crown_pos == ConstantsData.xy_to_pos(16, 10), "the crown drops where the King fell")
+	king.free()
